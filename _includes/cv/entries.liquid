{% assign has_logos = false %}
{% for content in entry.contents -%}
  {%- if content.logo %}{% assign has_logos = true %}{% endif -%}
{%- endfor %}
<div class="cv-entries{% if has_logos %} cv-timeline{% endif %}">
  {% for content in entry.contents %}
    <div class="cv-entry{% unless content.sub or content.items or content.desc %} cv-compact{% endunless %}">
      {% if has_logos %}
        <div class="cv-logo">
          {% if content.logo %}<img src="{{ content.logo | prepend: '/assets/img/cv/' | relative_url }}" alt="" loading="lazy">{% endif %}
        </div>
      {% endif %}
      <div class="cv-body">
        <div class="cv-head">
          <div class="cv-what">
            <b>{{ content.title }}</b>
            {%- if content.rest %}, {{ content.rest }}{% endif %}
          </div>
          {% if content.date %}
            <div class="cv-date">{{ content.date }}</div>
          {% endif %}
        </div>
        {% if content.sub %}
          <div class="cv-sub">{{ content.sub }}</div>
        {% endif %}
        {% if content.desc %}
          <div class="cv-desc">{{ content.desc }}</div>
        {% endif %}
        {% if content.items %}
          <ul class="cv-items">
            {% for item in content.items %}
              <li>{{ item }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>
