<div class="news">
  {% if include.limit -%}
    <h2 class="section-title"><a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a></h2>
  {%- endif %}
  {% if site.news != blank -%}
    {%- assign news_size = site.news | size -%}
    <div class="table-responsive" {% if site.news_scrollable and news_size > 3 %}style="max-height: 10vw"{% endif %}>
      <table class="table table-sm table-borderless news-table">
        {%- assign news = site.news | sort: 'date' | reverse -%}
        {% if include.limit and site.news_limit -%}
          {% assign news_limit = site.news_limit %}
        {%- else -%}
          {% assign news_limit = news_size %}
        {%- endif %}
        {% for item in news limit: news_limit -%}
          <tr>
            <th scope="row">{{ item.date | date: "%b %Y" }}</th>
            <td>
              {% if item.inline -%}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {%- else -%}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {%- endif %}
            </td>
          </tr>
        {%- endfor %}
      </table>
    </div>
  {%- else -%}
    <p>No news so far...</p>
  {%- endif %}
</div>
